# Environment Configuration for MNIST Classifier API

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=True
DEBUG=True

# Model Settings
MODEL_TYPE=final
MODEL_PATH=./models/final_model.pkl

# CORS Settings
CORS_ORIGINS=*
CORS_CREDENTIALS=True
CORS_METHODS=*
CORS_HEADERS=*

# Logging
LOG_LEVEL=INFO
LOG_FILE=api.log

# Security
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# Performance
ENABLE_CACHE=True
CACHE_TTL=3600
